# Microsoft: Entra admin center > App registrations > your app > Overview
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Your tenant id or domain (e.g. example.com). "organizations" works for any work/school account.
MS_TENANT=example.com

# Google: Cloud console > Google Auth Platform > Clients > your Desktop app client
GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# Optional: lets scripts call /api/ with "Authorization: Bearer <key>". 20+ random characters.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

TZ=UTC
DATA_PATH=./data
HOST_PORT=8080
